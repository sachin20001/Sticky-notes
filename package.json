{
  "name": "quicknote",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight desktop sticky note with one-click line copying.",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p electron/tsconfig.json --pretty false",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.quicknote.desktop",
    "productName": "QuickNote",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "mac": { "category": "public.app-category.productivity", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
